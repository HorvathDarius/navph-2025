                <ui:Button text="Pokračovať" name="ResumeButton" class="menu-button" style="width: 300px; height: 60px; margin-bottom: 15px; font-size: 34px; background-color: rgba(88, 175, 92, 0); color: rgb(0, 0, 0); border-radius: 10px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); background-image: url(&quot;project://database/Assets/Sprites/UI/button.png?fileID=2800000&amp;guid=c63cb698f15176d49a85152686e79728&amp;type=3#button&quot;); border-top-width: 0; border-right-width: 0; border-bottom-right-radius: 0; border-bottom-width: 0; border-bottom-left-radius: 0; border-left-width: 0; border-top-right-radius: 0; border-top-left-radius: 0; -unity-background-image-tint-color: rgb(255, 255, 255); -unity-font-style: normal;" />
                <ui:Button text="Nastavenia" name="SettingsButton" class="menu-button" style="width: 300px; height: 60px; margin-bottom: 15px; font-size: 24px; background-color: rgb(33, 150, 243); color: white; border-radius: 10px; display: none;" />
                <ui:Button text="Hlavné menu" name="MainMenuButton" class="menu-button" style="width: 300px; height: 60px; font-size: 34px; background-color: rgba(255, 255, 255, 0); color: rgb(0, 0, 0); border-radius: 10px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); background-image: url(&quot;project://database/Assets/Sprites/UI/button.png?fileID=2800000&amp;guid=c63cb698f15176d49a85152686e79728&amp;type=3#button&quot;); -unity-font-style: normal; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="GameOverPanel" enabled="true" class="overlay-panel" style="width: 100%; height: 100%; position: absolute; background-color: rgba(0, 0, 0, 0.9); justify-content: center; align-items: center; display: none; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); top: -1px; left: 0;">
            <ui:VisualElement name="GameOverContent" class="panel-content" style="width: 600px; padding: 50px; background-color: rgb(33, 33, 33); border-radius: 15px; border-width: 4px; border-color: rgb(244, 67, 54); align-items: center; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                <ui:Label text="GAME OVER" class="panel-title" style="font-size: 64px; color: rgb(244, 67, 54); -unity-font-style: bold; margin-bottom: 20px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                <ui:Label text="Nezomrel si, Ružinov bol za rohom.&#10;&#10;Nabudúce si daj od práce voľno." name="GameOverMessage" class="panel-message" style="font-size: 26px; color: white; text-align: center; white-space: normal; margin-bottom: 30px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                <ui:VisualElement name="StatsContainer" style="width: 100%; margin-bottom: 30px; padding: 20px; background-color: rgba(244, 67, 54, 0.2); border-radius: 10px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(244, 67, 54); border-left-color: rgb(244, 67, 54); border-right-color: rgb(244, 67, 54); border-bottom-color: rgb(244, 67, 54);">
                    <ui:Label text="Finálne skóre: 0" name="FinalScoreLabel" style="font-size: 28px; color: rgb(255, 193, 7); margin-bottom: 10px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                    <ui:Label text="Dosiahnutý level: 1" name="LevelReachedLabel" style="font-size: 28px; color: white; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                </ui:VisualElement>
                <ui:Button text="Skúsiť znova" name="RetryButton" class="menu-button" style="width: 350px; height: 70px; margin-bottom: 15px; font-size: 34px; background-color: rgba(76, 175, 80, 0); color: rgb(0, 0, 0); border-radius: 10px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; background-image: url(&quot;project://database/Assets/Sprites/UI/button.png?fileID=2800000&amp;guid=c63cb698f15176d49a85152686e79728&amp;type=3#button&quot;); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); -unity-font-style: normal;" />
                <ui:Button text="Hlavné menu" name="MainMenuButtonGO" class="menu-button" style="width: 350px; height: 70px; font-size: 34px; background-color: rgba(33, 150, 243, 0); color: rgb(0, 0, 0); border-radius: 10px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; background-image: url(&quot;project://database/Assets/Sprites/UI/button.png?fileID=2800000&amp;guid=c63cb698f15176d49a85152686e79728&amp;type=3#button&quot;); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="VictoryPanel" class="overlay-panel" style="width: 100%; height: 100%; position: absolute; background-color: rgba(0, 0, 0, 0.9); justify-content: center; align-items: center; display: none; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);">
            <ui:VisualElement name="VictoryContent" class="panel-content" style="width: 700px; padding: 50px; background-color: rgb(33, 33, 33); border-radius: 15px; border-width: 4px; border-color: rgb(76, 175, 80); align-items: center; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);">
                <ui:Label text="VÍŤAZSTVO!" class="panel-title" style="font-size: 64px; color: rgb(76, 175, 80); -unity-font-style: bold; margin-bottom: 20px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                <ui:Label text="Podarilo sa ti prežiť obednú pauzu!&#10;&#10;Zajtra to isté..." name="VictoryMessage" class="panel-message" style="font-size: 26px; color: white; text-align: center; white-space: normal; margin-bottom: 30px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                <ui:VisualElement name="VictoryStatsContainer" style="width: 100%; margin-bottom: 30px; padding: 25px; background-color: rgba(76, 175, 80, 0.2); border-radius: 10px; border-width: 2px; border-color: rgb(76, 175, 80); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                    <ui:Label text="Finálne skóre: 1500" name="VictoryScoreLabel" style="font-size: 28px; color: rgb(255, 193, 7); margin-bottom: 15px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                    <ui:Label text="Zostávajúci čas: 05:23" name="RemainingTimeLabel" style="font-size: 28px; color: rgb(255, 235, 59); margin-bottom: 10px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); height: 38px;" />
                    <ui:Label text="Zostávajúce zdravie: 65 HP" name="RemainingHealthLabel" style="font-size: 28px; color: rgb(76, 175, 80); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                </ui:VisualElement>
                <ui:Button text="Leaderboard" name="LeaderboardButton" class="menu-button" style="width: 400px; height: 70px; margin-bottom: 15px; font-size: 26px; background-color: rgb(255, 193, 7); color: black; border-radius: 10px; display: none;" />
                <ui:Button text="Hlavné menu" name="MainMenuButtonVictory" class="menu-button" style="width: 400px; height: 70px; font-size: 34px; background-color: rgba(33, 150, 243, 0); color: rgb(0, 0, 0); border-radius: 10px; background-image: url(&quot;project://database/Assets/Sprites/UI/button.png?fileID=2800000&amp;guid=c63cb698f15176d49a85152686e79728&amp;type=3#button&quot;); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); -unity-font-style: normal;" />
            </ui:VisualElement>
