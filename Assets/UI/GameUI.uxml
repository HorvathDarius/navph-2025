<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameUI.uss?fileID=7433441132597879392&amp;guid=50e38150df2ead2408a0a825ef96e1b0&amp;type=3" />
    <ui:VisualElement name="GameUI" style="width: 100%; height: 100%; position: absolute;">
        <ui:VisualElement name="HUD" class="hud-container" style="width: 100%; height: 100%; position: absolute; pointer-events: none; display: flex; top: 0; left: -2px;">
            <ui:VisualElement name="TopBar" class="top-bar" style="flex-direction: row; justify-content: space-between; padding: 20px; width: 100%; height: 100px;">
                <ui:VisualElement name="HealthSection" style="flex-direction: row; align-items: center; min-width: 300px; height: 102px;">
                    <ui:VisualElement name="PlayerIcon" class="player-icon" style="width: 100px; height: 100px; background-color: rgba(255, 255, 255, 0.2); border-radius: 5px; margin-right: 15px; background-image: url(&quot;project://database/Assets/Sprites/UI/main_char.png?fileID=2800000&amp;guid=4fa91e68992be724a91dbe57b48c032b&amp;type=3#main_char&quot;); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;" />
                    <ui:VisualElement name="HealthBarContainer" style="flex-direction: column; justify-content: center;">
                        <ui:Label text="HEALTH" name="HealthTitle" class="ui-label-small" style="margin-bottom: 5px; color: white; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); font-size: 36px; height: 56px;" />
                        <ui:VisualElement name="HealthBarBackground" style="width: 200px; height: 30px; background-color: rgba(0, 0, 0, 0.5); border-radius: 5px; border-width: 2px; border-color: white; bottom: auto; top: -17px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                            <ui:VisualElement name="HealthBarFill" style="width: 100%; height: 100%; background-color: rgb(76, 175, 80); border-radius: 5px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;" />
                        </ui:VisualElement>
                        <ui:Label text="Health: 100/100" name="HealthLabel" class="ui-label" style="margin-top: 5px; color: white; font-size: 28px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); height: 19px; top: -8px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="TimerSection" style="align-items: center; justify-content: center; min-width: 200px; flex-basis: 0%; position: absolute; right: 0; left: 0; top: 0;">
                    <ui:Label text="TIME" class="ui-label-small" style="color: white; -unity-font-style: bold; margin-bottom: 5px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); font-size: 36px;" />
                    <ui:Label text="15:00" name="TimerLabel" class="ui-label-large" style="font-size: 54px; color: rgb(255, 193, 7); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                </ui:VisualElement>
                <ui:VisualElement name="ScoreSection" style="align-items: flex-end; justify-content: center; min-width: 200px;">
                    <ui:Label text="SCORE" class="ui-label-small" style="color: white; -unity-font-style: bold; margin-bottom: 5px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); font-size: 36px;" />
                    <ui:Label text="0" name="ScoreLabel" class="ui-label-large" style="font-size: 54px; color: rgb(255, 193, 7); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ItemSelector" class="item-selector" style="position: absolute; bottom: 40px; left: 50%; translate: -50% 0; flex-direction: row; padding: 15px; background-color: rgba(0, 0, 0, 0.7); border-radius: 10px; border-width: 2px; border-color: white; display: none;">
                <ui:Label text="ITEMS:" style="color: white; margin-right: 15px; align-self: center; -unity-font-style: bold;" />
                <ui:VisualElement name="ItemSlot1" class="item-slot" style="width: 60px; height: 60px; background-color: rgba(255, 255, 255, 0.2); border-radius: 5px; margin-right: 10px; border-width: 2px; border-color: white;" />
                <ui:VisualElement name="ItemSlot2" class="item-slot" style="width: 60px; height: 60px; background-color: rgba(255, 255, 255, 0.2); border-radius: 5px; margin-right: 10px; border-width: 2px; border-color: white;" />
                <ui:VisualElement name="ItemSlot3" class="item-slot" style="width: 60px; height: 60px; background-color: rgba(255, 255, 255, 0.2); border-radius: 5px; border-width: 2px; border-color: white;" />
            </ui:VisualElement>
            <ui:VisualElement name="InventoryOverlay" class="inventory-overlay" style="position: absolute; bottom: 20px; right: 20px; width: 350px; height: 200px; background-color: rgba(0, 0, 0, 0.8); border-radius: 10px; border-width: 3px; border-color: white; display: none; flex-direction: column;">
                <ui:Label text="INVENTÁR" class="inventory-title" style="color: white; font-size: 18px; padding: 10px; -unity-font-style: bold;" />
                <ui:ListView name="InventoryList" class="inventory-list" style="flex-grow: 1; padding: 10px;" />
                <ui:VisualElement name="InventoryActions" style="flex-direction: row; padding: 10px; justify-content: space-between;">
