        </ui:VisualElement>
        <ui:VisualElement name="MazeFOVOverlay" style="width: 100%; height: 100%; position: absolute; background-image: url(&apos;Assets/UI/Textures/vignette.png&apos;); display: none;" />
        <ui:VisualElement name="BossHealthBar" style="position: absolute; top: auto; left: 50%; translate: -50% 0; width: 600px; display: none; bottom: 28px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;);">
            <ui:Label text="Spoluobčan bez trvalého bydliska" style="font-size: 24px; color: rgb(244, 67, 54); -unity-font-style: bold; margin-bottom: 5px; text-align: center; display: flex; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.otf?fileID=12800000&amp;guid=ac634b585e445774fa43c9654cfd2d4a&amp;type=3#BoldPixels&quot;); -unity-text-align: upper-center;" />
            <ui:VisualElement name="BossHealthBackground" style="width: 100%; height: 40px; background-color: rgba(0, 0, 0, 0.7); border-radius: 5px; border-width: 2px; border-color: rgb(244, 67, 54); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                <ui:VisualElement name="BossHealthFill" style="width: 100%; height: 100%; background-color: rgb(244, 67, 54); border-radius: 5px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
